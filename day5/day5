## Solution Code

```cpp
#include <bits/stdc++.h>
using namespace std;

class Graph
{
public:
    int V;
    vector<vector<int>> adj;

    Graph(int V)
    {
        this->V = V;
        adj.resize(V);
    }

    void addEdge(int u, int v)
    {
        adj[u].push_back(v);
    }

    void topo(int curr, vector<bool> &vis, stack<int> &s)
    {
        vis[curr] = true;

        for (int neigh : adj[curr])
        {
            if (!vis[neigh])
            {
                topo(neigh, vis, s);
            }
        }

        s.push(curr);
    }

    void dfs(int curr,
             vector<bool> &vis,
             vector<vector<int>> &transpose)
    {
        vis[curr] = true;

        cout << curr << " ";

        for (int neigh : transpose[curr])
        {
            if (!vis[neigh])
            {
                dfs(neigh, vis, transpose);
            }
        }
    }

    void kosaraju()
    {
        stack<int> s;
        vector<bool> vis(V, false);

        for (int i = 0; i < V; i++)
        {
            if (!vis[i])
            {
                topo(i, vis, s);
            }
        }

        vector<vector<int>> transpose(V);

        fill(vis.begin(), vis.end(), false);

        for (int u = 0; u < V; u++)
        {
            for (int v : adj[u])
            {
                transpose[v].push_back(u);
            }
        }

        cout << "Printing the SCC\n";

        while (!s.empty())
        {
            int curr = s.top();
            s.pop();

            if (!vis[curr])
            {
                dfs(curr, vis, transpose);
                cout << endl;
            }
        }
    }
};

int main()
{
    Graph graph(5);

    graph.addEdge(0, 2);
    graph.addEdge(0, 3);
    graph.addEdge(1, 0);
    graph.addEdge(2, 1);
    graph.addEdge(3, 4);

    graph.kosaraju();

    return 0;
}
```

