## Solution Code

```cpp
#include <bits/stdc++.h>
using namespace std;

class Graph
{
public:
    vector<vector<int>> adj;
    int V;

    Graph(int V)
    {
        this->V = V;
        adj.resize(V);
    }

    int time;
    vector<int> dt, low;

    void addEdge(int u, int v)
    {
        adj[u].push_back(v);
        adj[v].push_back(u);
    }

    void dfs(int u, int parU, set<int> &CP)
    {
        dt[u] = low[u] = ++time;
        int children = 0;

        for (int v : adj[u])
        {
            if (dt[v] == -1)
            {
                children++;

                dfs(v, u, CP);

                low[u] = min(low[u], low[v]);

                if (parU != -1 && low[v] >= dt[u])
                {
                    CP.insert(u);
                }
            }
            else if (v != parU)
            {
                low[u] = min(low[u], dt[v]);
            }
        }

        if (parU == -1 && children > 1)
        {
            CP.insert(u);
        }
    }

    int articulationPoint()
    {
        time = 0;

        dt.resize(V, -1);
        low.resize(V);

        set<int> criticalPoints;

        for (int i = 0; i < V; i++)
        {
            if (dt[i] == -1)
            {
                dfs(i, -1, criticalPoints);
            }
        }

        for (auto node : criticalPoints)
        {
            cout << node << " ";
        }

        cout << endl;

        return criticalPoints.size();
    }
};

int main()
{
    Graph g(6);

    g.addEdge(1, 0);
    g.addEdge(1, 2);
    g.addEdge(4, 3);
    g.addEdge(4, 5);
    g.addEdge(4, 1);

    cout << g.articulationPoint() << endl;

    return 0;
}
```
