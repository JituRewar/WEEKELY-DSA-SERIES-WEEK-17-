#include <bits/stdc++.h>
using namespace std;

int main()
{
    cout << "===== UNORDERED MAP =====\n";

    unordered_map<string, int> um;

    // insertion methods

    um.insert(make_pair("jitu", 1));

    um.insert({"jaat", 2});

    um["merta"] = 3;

    um["merta"] = 85; // update value

    // access

    cout << "Value of merta : "
         << um["merta"] << endl;

    // size

    cout << "Size : "
         << um.size() << endl;

    // count

    cout << "Count of jitu : "
         << um.count("jitu") << endl;

    // find

    if (um.find("jaat") != um.end())
    {
        cout << "jaat found\n";
    }

    // traversal using iterator

    cout << "\nIterator Traversal:\n";

    unordered_map<string, int>::iterator it;

    for (it = um.begin(); it != um.end(); it++)
    {
        cout << it->first
             << " "
             << it->second
             << endl;
    }

    // range based loop

    cout << "\nRange Based Loop:\n";

    for (auto x : um)
    {
        cout << x.first
             << " "
             << x.second
             << endl;
    }

    // erase

    um.erase("jaat");

    cout << "\nAfter erase:\n";

    for (auto x : um)
    {
        cout << x.first
             << " "
             << x.second
             << endl;
    }

    cout << "\n\n===== ORDERED MAP =====\n";

    map<string, int> mp;

    mp["jitu"] = 1;
    mp["jaat"] = 2;
    mp["merta"] = 85;
    mp["kota"] = 100;

    // automatically sorted by key

    for (auto x : mp)
    {
        cout << x.first
             << " "
             << x.second
             << endl;
    }

    cout << "\nSize : "
         << mp.size()
         << endl;

    cout << "Count of kota : "
         << mp.count("kota")
         << endl;

    mp.erase("jaat");

    cout << "\nAfter erase:\n";

    for (auto x : mp)
    {
        cout << x.first
             << " "
             << x.second
             << endl;
    }

    return 0;
}
