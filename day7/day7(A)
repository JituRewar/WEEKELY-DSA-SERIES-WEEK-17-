unordered_map<char,int> freq;

for(char ch : s)
{
    freq[ch]++;
}
Detect Duplicates
unordered_map<int,int> mp;

for(int x : arr)
{
    if(mp.count(x))
    {
        cout<<"Duplicate Found";
    }

