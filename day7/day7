#include <bits/stdc++.h>
using namespace std;

// Min Heap (0-Based Indexing)

class MinHeap
{
public:
    vector<int> arr;

    void insert(int val)
    {
        arr.push_back(val);

        int index = arr.size() - 1;

        while (index > 0)
        {
            int parent = (index - 1) / 2;

            if (arr[parent] > arr[index])
            {
                swap(arr[parent], arr[index]);
                index = parent;
            }
            else
            {
                break;
            }
        }
    }

    void print()
    {
        for (auto x : arr)
        {
            cout << x << " ";
        }
        cout << endl;
    }
};

void heapify(int arr[], int n, int i)
{
    int smallest = i;

    int left = 2 * i + 1;
    int right = 2 * i + 2;

    if (left < n && arr[left] < arr[smallest])
        smallest = left;

    if (right < n && arr[right] < arr[smallest])
        smallest = right;

    if (smallest != i)
    {
        swap(arr[i], arr[smallest]);
        heapify(arr, n, smallest);
    }
}

int main()
{
    MinHeap h;

    h.insert(50);
    h.insert(55);
    h.insert(53);
    h.insert(52);
    h.insert(51);

    cout << "Min Heap:\n";
    h.print();

    int arr[] = {7, 5, 8, 89, 45, 50};
    int n = sizeof(arr) / sizeof(arr[0]);

    for (int i = n / 2 - 1; i >= 0; i--)
    {
        heapify(arr, n, i);
    }

    cout << "\nBuilt Min Heap:\n";

    for (int i = 0; i < n; i++)
    {
        cout << arr[i] << " ";
    }

    return 0;
}
3. HeapSort.cpp
#include <bits/stdc++.h>
using namespace std;

void heapify(int arr[], int n, int i)
{
    int largest = i;

    int left = 2 * i;
    int right = 2 * i + 1;

    if (left <= n && arr[left] > arr[largest])
        largest = left;

    if (right <= n && arr[right] > arr[largest])
        largest = right;

    if (largest != i)
    {
        swap(arr[i], arr[largest]);
        heapify(arr, n, largest);
    }
}

void heapSort(int arr[], int n)
{
    int size = n;

    while (size > 1)
    {
        swap(arr[1], arr[size]);

        size--;

        heapify(arr, size, 1);
    }
}

int main()
{
    int arr[7] = {-1, 40, 20, 30, 10, 5, 15};

    int n = 6;

    for (int i = n / 2; i > 0; i--)
    {
        heapify(arr, n, i);
    }

    heapSort(arr, n);

    cout << "Sorted Array:\n";

    for (int i = 1; i <= n; i++)
    {
        cout << arr[i] << " ";
    }

    return 0;
}
